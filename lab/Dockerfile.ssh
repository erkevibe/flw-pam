FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/ssh/ssh_host_* \
    && useradd --create-home --shell /bin/bash pam-lab \
    && printf '%s\n' \
       'Port 22' \
       'ListenAddress 0.0.0.0' \
       'HostKey /etc/ssh/ssh_host_ed25519_key' \
       'PermitRootLogin no' \
       'PasswordAuthentication yes' \
       'KbdInteractiveAuthentication no' \
       'PermitEmptyPasswords no' \
       'UsePAM no' \
       'AllowUsers pam-lab' \
       'AllowTcpForwarding no' \
       'AllowAgentForwarding no' \
       'X11Forwarding no' \
       'PermitTunnel no' \
       'PidFile /run/sshd.pid' \
       > /etc/pam-lab-sshd_config \
    && printf '%s\n' \
       '#!/bin/sh' \
       'set -eu' \
       'test "${SSH_USERNAME:?}" = pam-lab' \
       'case "${SSH_PASSWORD:?}" in *[!A-Za-z0-9_-]*) exit 1;; esac' \
       'printf "%s:%s\n" "$SSH_USERNAME" "$SSH_PASSWORD" | chpasswd' \
       'unset SSH_PASSWORD' \
       'mkdir -p /run/sshd' \
       'umask 077' \
       'if [ ! -e /etc/ssh/ssh_host_ed25519_key ]; then' \
       '  test ! -e /etc/ssh/ssh_host_ed25519_key.pub' \
       '  ssh-keygen -q -t ed25519 -N "" -f /etc/ssh/ssh_host_ed25519_key >/dev/null' \
       'fi' \
       'test -s /etc/ssh/ssh_host_ed25519_key.pub' \
       'exec /usr/sbin/sshd -D -e -f /etc/pam-lab-sshd_config' \
       > /usr/local/sbin/start-lab-sshd \
    && chmod 0755 /usr/local/sbin/start-lab-sshd

ENTRYPOINT ["/usr/local/sbin/start-lab-sshd"]
